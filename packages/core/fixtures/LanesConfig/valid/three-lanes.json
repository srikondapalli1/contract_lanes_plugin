{ "lanes_version": "^0.1.0", "approvers": ["@you"],
  "settings": { "autopilot": true, "stop_gate": false, "fix_size_cap": 200, "fix_attempts": 2, "lease_minutes": 30, "property_runs": 200, "watch_interval_sec": 20, "contracts_dir": "contracts", "fixtures_dir": "fixtures" },
  "lanes": { "world": { "owner": "@you", "paths": ["apps/world/**"] }, "brain": { "owner": "@friend", "paths": ["apps/brain/**"] }, "crowd": { "owner": "@you", "paths": ["apps/crowd/**"] } },
  "contracts": { "TickRequest": { "producer": "world", "consumers": ["brain"] }, "TickResponse": { "producer": "brain", "consumers": ["world"] }, "Haunt": { "producer": "crowd", "consumers": ["world", "brain"] } },
  "handlers": { "tick": { "lane": "brain", "module": "apps/brain/src/tick.ts#tick", "input": "TickRequest", "output": "TickResponse" } } }
