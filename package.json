{
  "name": "contract-lanes",
  "version": "0.1.4",
  "type": "module",
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "description": "Contract-first parallel development for coding agents: lanes, zod contracts, deterministic checks, hooks, merge queue.",
  "license": "MIT",
  "bin": {
    "lanes": "plugin/bin/lanes.mjs"
  },
  "exports": {
    "./test": {
      "types": "./plugin/bin/test.d.ts",
      "default": "./plugin/bin/test.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "plugin/bin",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/srikondapalli1/contract_lanes_plugin.git"
  },
  "keywords": [
    "claude-code",
    "plugin",
    "contracts",
    "zod",
    "agents",
    "parallel",
    "merge-queue"
  ],
  "scripts": {
    "bundle": "node scripts/build.mjs",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "test:e2e": "vitest run packages/core/test/e2e",
    "check": "node plugin/bin/lanes.mjs check",
    "lines": "node scripts/lines.mjs",
    "prepublishOnly": "node scripts/check-lf.mjs"
  },
  "peerDependencies": {
    "zod": "^4.1.0",
    "vitest": ">=3.2.0"
  },
  "packageManager": "pnpm@10.28.0",
  "dependencies": {
    "fast-check": "^4.11.0"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  }
}
